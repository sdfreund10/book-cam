<%- include('../partials/header', { title: book.title }) %>

<div class="page-heading">
  <h1><%= book.title %></h1>
  <div class="book-card-actions">
    <a class="button" href="/books/<%= book.id %>/edit">Edit</a>
    <form method="POST" action="/books/<%= book.id %>/delete" onsubmit="return confirm('Delete this book?');">
      <button type="submit" class="button danger">Delete</button>
    </form>
  </div>
</div>

<p class="library-link-row">
  <a class="library-link" href="<%= buildLibrarySearchUrl(book.title) %>" target="_blank" rel="noopener noreferrer">🔎 Search library for this title</a>
</p>

<dl class="book-details">
  <dt>Author</dt>
  <dd><%= book.author %></dd>

  <dt>Status</dt>
  <dd><span class="status-badge status-<%= book.status.replace(' ', '-') %>"><%= book.status %></span></dd>

  <% if (book.coverImageUri) { %>
    <dt>Cover</dt>
    <dd><img class="cover-image" src="<%= book.coverImageUri %>" alt="Cover of <%= book.title %>" /></dd>
  <% } %>

  <% if (book.notes) { %>
    <dt>Notes</dt>
    <dd><%= book.notes %></dd>
  <% } %>

  <dt>Added</dt>
  <dd><%= new Date(book.createdAt).toLocaleString() %></dd>

  <dt>Last updated</dt>
  <dd><%= new Date(book.updatedAt).toLocaleString() %></dd>
</dl>

<p><a href="/books">&larr; Back to all books</a></p>

<%- include('../partials/footer') %>

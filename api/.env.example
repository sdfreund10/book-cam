PORT=3000
NODE_ENV=development

# Required for the "scan a cover" feature (POST /api/books/scan, /books/scan).
# Without this set, scanning will still work but will skip straight to
# asking the user to fill in the book details manually.
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5

# Used to look up canonical title/author/cover art once the vision model
# has made a guess. Defaults to the public Open Library instance.
OPEN_LIBRARY_BASE_URL=https://openlibrary.org

# Base URL for the "search library" link shown on book pages. Book IDs don't
# translate between library systems, so this just opens a title search.
# Defaults to Multnomah County Library. Point this at your own BiblioCommons
# (or similar) catalog if you use a different library system.
LIBRARY_CATALOG_BASE_URL=https://multcolib.bibliocommons.com

DATABASE_URL=postgresql://book_camera:book_camera@localhost:5432/book_camera_development

# Tests always use book_camera_test (set in vitest.config.ts). Create it with:
#   createdb -O book_camera book_camera_test
# then push the schema with:
#   npm run db:push:test
# (use npm run db:push:dev for book_camera_development)
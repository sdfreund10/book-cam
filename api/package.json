{
  "name": "book-camera-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "ts-standard",
    "lint:fix": "ts-standard --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push:dev": "DATABASE_URL=postgresql://book_camera:book_camera@localhost:5432/book_camera_development drizzle-kit push",
    "db:push:test": "DATABASE_URL=postgresql://book_camera:book_camera@localhost:5432/book_camera_test drizzle-kit push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "supertest": "^7.2.2",
    "ts-standard": "^12.0.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
